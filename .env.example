# Copy to .env and fill in real values. Never commit .env.
# This file lists variable NAMES only — no real secrets.

# --- General ---
ENVIRONMENT=development
FRONTEND_URL=
CORS_ORIGINS=

# --- Database ---
DATABASE_URL=

# --- Cache / Queue broker ---
REDIS_URL=

# --- Auth / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Payments (provider-agnostic; PAYMENT_PROVIDER selects the adapter) ---
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Object storage (provider-agnostic; STORAGE_PROVIDER selects the adapter) ---
STORAGE_PROVIDER=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI assistant (provider-agnostic; LLM_PROVIDER selects the adapter) ---
LLM_PROVIDER=
LLM_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
